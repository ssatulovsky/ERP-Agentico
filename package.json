{
  "name": "erpremia",
  "version": "2.0.0",
  "description": "ERPremIA - Sistema ERP Contable, Tributario y Agéntico Autónomo para Chile",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build && ./node_modules/esbuild/bin/esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist server.js",
    "db:init:mysql": "node ./node_modules/tsx/dist/cli.mjs src/scripts/initMysqlDb.ts",
    "db:update:mysql": "node ./node_modules/tsx/dist/cli.mjs src/scripts/updateMysqlDb.ts",
    "db:migrate:mysql": "node ./node_modules/tsx/dist/cli.mjs src/scripts/migrateMysql.ts",
    "download:voices": "bash scripts/download_all_piper_voices.sh",
    "download:voices:node": "node ./node_modules/tsx/dist/cli.mjs src/scripts/downloadPiperVoices.ts",
    "setup:install": "node ./node_modules/tsx/dist/cli.mjs src/scripts/installSystem.ts",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/tsx/dist/cli.mjs tests/agent_tools.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/e2e_audit_verification.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/http_security_rbac.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/http_route_perimeter.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/autonomous_agents_modules.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/phase0_repository.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/phase1_regressions.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/phase2_regressions.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "bullmq": "^6.3.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.3",
    "playwright": "^1.63.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4"
  }
}
