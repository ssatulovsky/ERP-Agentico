# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# REDIS CONFIGURATION: Conexión para colas de trabajo asíncronas BullMQ y workers (opcional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=Clausus2k9
REDIS_TLS=false
REDIS_URL="rediss://default:Clausus2k9@127.0.0.1:6379"

# SEGURIDAD Y AUDITORÍA CRIPTOGRÁFICA
# Clave maestra HMAC-SHA256 para firma inmutable de comprobantes contables por el Agente Supervisor (mínimo 32 caracteres / 256 bits)
SUPERVISOR_HMAC_SECRET=

