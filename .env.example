# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE PRODUCCIÓN - ERP AGÉNTICO CONTABLE CHILE
# Archivo: .env.production / .env
# Normativa: SII, IFRS, Dirección del Trabajo (Código del Trabajo, Ley 21.643 Karin)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO Y RED (Nota: No definir NODE_ENV aquí para evitar advertencias de Vite)
# ------------------------------------------------------------------------------
PORT=3000
APP_URL="https://erp.tu-estudio.cl"

# Modo demostración: con "true" se cargan las empresas de ejemplo con sus datos semilla
# (DTEs, nóminas, cartolas, inventario). En producción debe quedar en "false":
# ningún cliente real recibe datos semilla.
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. MOTOR DE BASE DE DATOS TRANSACCIONAL (MYSQL 8.0+ INNODB / DRIZZLE ORM)
# ------------------------------------------------------------------------------
# Cadena de conexión completa o parámetros individuales
MYSQL_URL="mysql://erp_user:TuPasswordSuperSeguro2026!@127.0.0.1:3306/erp_contable?ssl=false"
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=erp_user
MYSQL_PASSWORD=TuPasswordSuperSeguro2026!
MYSQL_DATABASE=erp_contable
MYSQL_CONNECTION_LIMIT=25

# ------------------------------------------------------------------------------
# 3. COLAS ASÍNCRONAS Y SISTEMA DISTRIBUIDO (REDIS 7+ / BULLMQ)
# ------------------------------------------------------------------------------
# Requerido en producción para procesamiento desatendido con reintentos exponenciales
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=TuPasswordRedisCluster2026!
REDIS_TLS=false
REDIS_URL="redis://:TuPasswordRedisCluster2026!@127.0.0.1:6379"

# ------------------------------------------------------------------------------
# 4. SEGURIDAD CRIPTOGRÁFICA, HMAC Y VAULT DE CREDENCIALES
# ------------------------------------------------------------------------------
# Clave maestra HMAC-SHA256 para firma inmutable de comprobantes contables por el Orquestador Senior (Mínimo 32 caracteres)
SUPERVISOR_HMAC_SECRET="e9a71f0284b3cd5e109f58231a47df82049e6c1a82d098e98214fa734bca881e"
SUPERVISOR_SECRET="e9a71f0284b3cd5e109f58231a47df82049e6c1a82d098e98214fa734bca881e"

# Clave Maestra de Cifrado AES-256-GCM para el Vault de Certificados Digitales y Claves SII/Bancos
VAULT_MASTER_SECRET="9f8b4c2d1e0a7e6f5d4c3b2a19807f6e5d4c3b2a10987e6d5c4b3a2f1e0d9c8b"

# ------------------------------------------------------------------------------
# 5. INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI 3.8 / ANTHROPIC / OPENAI GATEWAYS)
# ------------------------------------------------------------------------------
# Llave de API del modelo de lenguaje para el Orquestador Agéntico Contable
GEMINI_API_KEY=""

# 3.3 Tareas programadas de agentes (conciliación diaria, RCV diario, borrador F29, depreciación).
# Activar en UNA sola instancia del servidor. Las horas programadas son de America/Santiago.
AGENT_SCHEDULER_ENABLED=false
AGENT_SCHEDULER_TICK_MS=60000

# ------------------------------------------------------------------------------
# 6. INTEGRACIÓN DIRECTA CON EL SII (SERVICIO DE IMPUESTOS INTERNOS)
# ------------------------------------------------------------------------------
# Gateway de Facturación Electrónica y Sincronización RCV (LibreDTE, SimpleAPI o Gateway Propio)
SII_API_GATEWAY_URL="https://api.sii.cl/v1"
SII_API_KEY=""
SII_GATEWAY_URL="https://api.sii.cl/v1"
SII_GATEWAY_TOKEN=""
SII_RUT=""
SII_PASSWORD=""

# ------------------------------------------------------------------------------
# 7. INDICADORES ECONÓMICOS EN TIEMPO REAL (BANCO CENTRAL / MINDICADOR.CL)
# ------------------------------------------------------------------------------
INDICATORS_API_URL="https://mindicador.cl/api"

# ------------------------------------------------------------------------------
# 8. FACTURACIÓN ELECTRÓNICA NATIVA HTTP-DTE / LIBREDTE (API REST SLIM EN LOCALHOST:8050)
# ------------------------------------------------------------------------------
# URL del servicio HTTP-DTE local (Slim framework / PHP LibreDTE)
HTTP_DTE_URL="http://localhost:8050"

# Ambiente SII: 1 = Certificación (Palena/Maullin), 2 = Producción
DTE_AMBIENTE=1

# Ruta local del Certificado Digital tributario (.p12 o .pfx)
DTE_CERT_PATH="./certs/certificado.p12"

# Contraseña del Certificado Digital
DTE_CERT_PASSWORD="tu_password_certificado"

# Opcional: Base64 directo del certificado digital (si no se usa archivo en disco)
# DTE_CERT_BASE64=""

# Directorio que contiene los archivos CAF (.xml) por tipo de DTE (F33.xml, F34.xml, etc.)
DTE_CAF_DIR="./certs/caf"

# Opcional: Ruta específica a un CAF XML
# DTE_CAF_PATH="./certs/caf/F33.xml"

# Timeout y reintentos HTTP para el timbrado
HTTP_DTE_TIMEOUT_MS=30000
HTTP_DTE_MAX_RETRIES=3

# Timbrado simulado offline SOLO para desarrollo (DTE con estado SIMULADO, sin validez tributaria).
# Con NODE_ENV=production o DTE_AMBIENTE=2 y este valor en true, el servidor NO arranca.
ALLOW_OFFLINE_DTE_SIMULATION=false
